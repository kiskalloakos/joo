{
  "expo": {
    "name": "joo",
    "slug": "joo",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/joo-ios-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "famescale",
    "ios": {
      "icon": "./assets/joo-ios-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "co.famescale.joo",
      "buildNumber": "9",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.famescale.joo",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/joo-ios-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/joo-ios-icon-192.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/joo-ios-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bfba67d-9223-410d-ae19-03d31dc80615"
      }
    },
    "owner": "kiskalloakos",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9bfba67d-9223-410d-ae19-03d31dc80615"
    }
  }
}
